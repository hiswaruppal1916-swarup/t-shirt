# Supabase Configuration (Frontend Safe)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Firebase Configuration (Frontend Safe)
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Secure Backend Secrets (NEVER put these in client frontend code or public repositories)
# Configure these in Supabase Edge Functions / Backend server environment:
# QIKINK_CLIENT_ID=your_qikink_client_id
# QIKINK_CLIENT_SECRET=your_qikink_client_secret
